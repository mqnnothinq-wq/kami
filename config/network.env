# shellcheck shell=bash disable=SC2034
# Ağ geneli ayarlar (bash KEY="değer" biçimi; betikler bu dosyayı "source" eder).
# Burada GİZLİ DEĞER YOK: şifreler /etc/minecraft/secrets.env içindedir (depoya girmez).
# Config dosyalarındaki @@DEĞİŞKEN@@ yer tutucuları önce server.env, sonra secrets.env,
# en son bu dosyadan doldurulur.

# --- Sürümler -----------------------------------------------------------------
# Paper'ın izlediği Minecraft sürümü. 26.3 henüz BETA; 26.3 istemcileri ViaVersion ile girer.
PAPER_MC_VERSION="26.2"
# Yalnız kararlı (STABLE) Paper build'leri indirilir.
PAPER_CHANNEL="STABLE"
# "latest" = SNAPSHOT içermeyen en yeni Velocity sürümü; sabitlemek için ör. "4.2.1".
# 26.3 istemcileri için en az 4.2.0 gerekir.
VELOCITY_VERSION="latest"
# Giriş (auth) bekleme sunucusu PicoLimbo'nun sürümü (GitHub release etiketi).
PICOLIMBO_VERSION="v1.14.1+mc26.3"
# LibreLogin kaynaktan derlenir (yayınlanmış 26.x sürümü yok); sabit commit.
# Değiştirirseniz canlıya almadan önce giriş duman testini (docs/08) tekrarlayın ve
# config/plugins.list'teki LibreLogin-<ilk 7 hane>.jar yolunu da güncelleyin.
LIBRELOGIN_COMMIT="39397c47585e193d71cc84d3043f4a61df725124"

# --- Dışarıya açık portlar (UFW bunları açar) ----------------------------------
PUBLIC_JAVA_PORT="25565"
PUBLIC_BEDROCK_PORT="19132"

# --- Genel --------------------------------------------------------------------
TIMEZONE="Europe/Istanbul"
# PaperMC indirme servisi tanımlayıcı bir User-Agent ister (iletişim adresiyle).
DOWNLOAD_USER_AGENT="kami-mc-tr/1.0 (+https://github.com/mqnnothinq-wq/kami)"

# --- Veritabanı (MariaDB, yalnız 127.0.0.1) -------------------------------------
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_USER="minecraft"
# install.sh bu veritabanlarını oluşturur. LibreLogin SQLite kullandığından "auth" gerekmez.
DB_DATABASES="luckperms"

# --- Yedekleme saklama politikası (restic forget) ---------------------------------
BACKUP_KEEP_HOURLY="24"
BACKUP_KEEP_DAILY="7"
BACKUP_KEEP_WEEKLY="4"
BACKUP_KEEP_MONTHLY="6"

# --- Günlük saklama (KVKK) ----------------------------------------------------------
# mc backup prune: logs/*.log.gz dosyaları bu kadar günden eskiyse silinir.
LOG_RETENTION_DAYS="90"
