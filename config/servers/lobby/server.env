# shellcheck shell=bash disable=SC2034
# Lobi (Paper) — girişten sonra herkesin düştüğü sunucu. Yalnız 127.0.0.1'de dinler.
TYPE="paper"
PORT="30066"
# RCON yalnız 127.0.0.1'de; port = PORT + 1000.
RCON_PORT="31066"
# Lobide dünya küçük, mob yok: 1.5 GB yeterli.
HEAP="1536M"
CPU_WEIGHT="100"
# Bellek darlığında önce lobi ölsün (oyuncular hayatta kalma dünyasında kaybetmesin).
OOM_SCORE_ADJUST="200"
# Küçük heap → 2 GC iş parçacığı yeterli (varsayılan 8'dir, diğer JVM'lerle çekişir).
GC_THREADS="2"
EXTRA_JAVA_OPTS=""
