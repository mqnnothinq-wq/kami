# shellcheck shell=bash disable=SC2034
# Velocity proxy — oyuncuların bağlandığı tek giriş noktası (Java TCP 25565 + Geyser UDP 19132).
TYPE="velocity"
# velocity.toml'daki bind = "0.0.0.0:@@PORT@@" buradan gelir. network.env PUBLIC_JAVA_PORT ile aynı olmalı.
PORT="25565"
# Velocity'de RCON yok; konsol komutları için: mc cmd velocity <komut>
RCON_PORT=""
# ~100 oyuncu + Geyser + Sonar için 1 GB yeterli (PaperMC: 500 oyuncu başına 512 MB + ~1 GB).
HEAP="1G"
# CPU payı: proxy gecikmesi tüm oyuncuları etkiler, o yüzden lobiden yüksek.
CPU_WEIGHT="200"
# Bellek darlığında çekirdek (OOM killer) proxy'yi EN SON öldürsün.
OOM_SCORE_ADJUST="-200"
# GC iş parçacığı sınırı: 8 vCPU'yu 3 JVM paylaşır; proxy'nin heap'i küçük, 2 yeterli.
GC_THREADS="2"
# config/jvm/velocity.flags dışında ek JVM bayrakları (genelde boş kalır).
EXTRA_JAVA_OPTS=""
