# shellcheck shell=bash disable=SC2034
# Giriş bekleme sunucusu (PicoLimbo, Java DEĞİL — yerel ikili). Kırık (cracked) oyuncular
# /register ya da /login yapana kadar burada bekler. Yalnız 127.0.0.1'de dinler; velocity.toml'da
# "limbo" adıyla kayıtlıdır ve ASLA "try" listesine konmaz.
TYPE="limbo"
PORT="30065"
# RCON, heap ve JVM ayarları yok (Java değil).
RCON_PORT=""
HEAP=""
CPU_WEIGHT="50"
# Bellek darlığında ilk ölecek süreç (hafif; yeniden başlaması saniyeler sürer).
OOM_SCORE_ADJUST="300"
GC_THREADS=""
EXTRA_JAVA_OPTS=""
