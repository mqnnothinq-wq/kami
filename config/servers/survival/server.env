# shellcheck shell=bash disable=SC2034
# Ana oyun sunucusu (Paper). Oyun modu henüz seçilmedi; genel amaçlı hayatta kalma dünyası.
TYPE="paper"
PORT="30067"
RCON_PORT="31067"
# Oyuncuların çoğu burada: 7 GB. RAM ölçümü (mc doctor, spark) sonrası 8G'ye çıkarılabilir.
HEAP="7G"
# En çok CPU payı ana sunucuda (tek ana iş parçacığı TPS'i belirler).
CPU_WEIGHT="300"
OOM_SCORE_ADJUST="0"
# Boş = JVM varsayılanı (8 vCPU'da 8 GC iş parçacığı); büyük heap bundan yararlanır.
GC_THREADS=""
EXTRA_JAVA_OPTS=""
